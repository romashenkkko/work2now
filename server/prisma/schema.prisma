  staff_user_id           String                    @db.Char(36)
  is_default              Boolean                   @default(false)
  status                  staff_payout_account_status @default(draft)
  type                    staff_payout_account_type
  beneficiary_name        String                    @db.VarChar(200)
  beneficiary_country     String?                   @db.VarChar(2)
  iban                    String?                   @db.VarChar(34)
  bank_name               String?                   @db.VarChar(200)
  card_token              String?                   @db.VarChar(200)
  card_last4              String?                   @db.VarChar(4)
  card_brand              String?                   @db.VarChar(50)
  phone_e164              String?                   @db.VarChar(20)
  wallet_provider         String?                   @db.VarChar(50)
  verification_provider   String?                   @db.VarChar(50)
