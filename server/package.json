{
  "name": "work2now-server",
  "version": "1.0.0",
  "description": "Work2Now API - Node.js + Express + TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "prisma:generate": "node scripts/prisma-with-env.cjs generate",
    "prisma:migrate": "node scripts/prisma-with-env.cjs migrate dev",
    "prisma:migrate:init": "node scripts/prisma-with-env.cjs migrate dev --name init",
    "prisma:studio": "node scripts/prisma-with-env.cjs studio",
    "db:add-attachment-urls": "node scripts/prisma-with-env.cjs db execute --file prisma/scripts/add_jobs_attachment_urls.sql --schema prisma/schema.prisma",
    "prisma:resolve-attachment-migration": "node scripts/prisma-with-env.cjs migrate resolve --applied 20260324120000_job_attachment_urls",
    "prisma:migrate:deploy": "node scripts/prisma-with-env.cjs migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.8",
    "twilio": "^5.12.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "prisma": "^5.21.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
